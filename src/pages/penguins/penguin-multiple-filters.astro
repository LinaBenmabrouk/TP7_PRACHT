---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
---

<Layout>
  <div class="min-h-screen bg-slate-50 text-slate-800">
    <main class="mx-auto max-w-6xl px-5 py-8">
      <Header />

      <header class="mb-10 border-b border-slate-300 pb-7">
        <h1 class="text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
          Penguins avec plusieurs filtres
        </h1>
        <p class="mt-3 text-base text-slate-600">
          Filtrer les manchots par espèce, île et sexe.
        </p>
      </header>

      <section class="border border-slate-200 bg-white p-5">
        <div class="flex flex-wrap gap-5">
          <div>
            <label for="species-filter" class="mb-2 block text-sm font-medium text-slate-700">
              Espèce
            </label>
            <select
              name="species"
              id="species-filter"
              class="cursor-pointer rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm outline-none transition hover:border-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
            >
              <option value="">Toutes les espèces</option>
              <option value="Adelie">Adelie</option>
              <option value="Chinstrap">Chinstrap</option>
              <option value="Gentoo">Gentoo</option>
            </select>
          </div>

          <div>
            <label for="island-filter" class="mb-2 block text-sm font-medium text-slate-700">
              Île
            </label>
            <select
              name="island"
              id="island-filter"
              class="cursor-pointer rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm outline-none transition hover:border-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
            >
              <option value="">Toutes les îles</option>
              <option value="Biscoe">Biscoe</option>
              <option value="Dream">Dream</option>
              <option value="Torgersen">Torgersen</option>
            </select>
          </div>

          <div>
            <label for="sex-filter" class="mb-2 block text-sm font-medium text-slate-700">
              Sexe
            </label>
            <select
              name="sex"
              id="sex-filter"
              class="cursor-pointer rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm outline-none transition hover:border-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
            >
              <option value="">Tous les sexes</option>
              <option value="MALE">MALE</option>
              <option value="FEMALE">FEMALE</option>
            </select>
          </div>
        </div>

        <div id="myplot" class="mt-6"></div>
      </section>
    </main>
  </div>

  <script>
    import * as Plot from "@observablehq/plot";
    import penguins from "../../assets/penguins.json";

    const selectSpecies = document.querySelector("#species-filter") as HTMLSelectElement;
    const selectIsland = document.querySelector("#island-filter") as HTMLSelectElement;
    const selectSex = document.querySelector("#sex-filter") as HTMLSelectElement;
    const plotContainer = document.querySelector("#myplot") as HTMLDivElement;

    function renderPlot() {
      const species = selectSpecies.value;
      const island = selectIsland.value;
      const sex = selectSex.value;

      const filteredPenguins = penguins.filter((penguin) => {
        const matchesSpecies = !species || penguin.species === species;
        const matchesIsland = !island || penguin.island === island;
        const matchesSex = !sex || penguin.sex === sex;

        return matchesSpecies && matchesIsland && matchesSex;
      });

      plotContainer.replaceChildren();

      const plot = Plot.plot({
        grid: true,
        color: {
          legend: true,
        },
        x: {
          label: "Longueur du bec (mm)",
        },
        y: {
          label: "Profondeur du bec (mm)",
        },
        marks: [
          Plot.dot(filteredPenguins, {
            x: "culmen_length_mm",
            y: "culmen_depth_mm",
            stroke: "species",
          }),
        ],
      });

      plotContainer.append(plot);
    }

    [selectSpecies, selectIsland, selectSex].forEach((select) => {
      select.addEventListener("change", renderPlot);
    });
    renderPlot();
  </script>
</Layout>
