---
import * as Plot from "@observablehq/plot";
import { JSDOM } from "jsdom";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import populationMain from "../assets/populationMain.json";
import departements from "../assets/departements.geojson.json";

const selectedPeriod = 2021;
const selectedSex = "Total";
const selectedAge = "Total";

const populationByDepartment = new Map(
  populationMain
    .filter(
      (entry) =>
        entry["Période"] === selectedPeriod &&
        entry["Sexe"] === selectedSex &&
        entry["Âge"] === selectedAge
    )
    .map((entry) => [entry["Géographie"], entry.Valeur])
);

const features = departements.features.map((feature) => ({
  ...feature,
  properties: {
    ...feature.properties,
    population: populationByDepartment.get(feature.properties.nom) ?? null,
  },
}));

const plot = Plot.plot({
  document: new JSDOM("").window.document,
  width: 960,
  height: 680,
  title: "Population des départements français en 2021",
  subtitle: "Population totale, tous sexes et tous âges confondus.",
  caption: "Figure 1. Population départementale selon les données du recensement.",
  ariaLabel: "Carte choroplèthe de la population des départements français en 2021.",
  projection: {
    type: "mercator",
    domain: { type: "FeatureCollection", features },
  },
  color: {
    scheme: "YlGnBu",
    label: "Population",
    unknown: "#e5e7eb",
  },
  marks: [
    Plot.geo(features, {
      fill: "population",
      stroke: "white",
      strokeWidth: 0.5,
      tip: true,
    }),
  ],
});
---

<Layout>
  <div class="min-h-screen bg-slate-50 text-slate-800">
    <main class="mx-auto max-w-6xl px-5 py-8">
      <Header />

      <header class="mb-10 border-b border-slate-300 pb-7">
        <h1 class="text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
          Population des départements
        </h1>
        <p class="mt-3 text-base text-slate-600">
          Carte rendue côté serveur à partir des données GeoJSON et du fichier de population.
        </p>
      </header>

      <figure class="overflow-x-auto border border-slate-200 bg-white p-3 sm:p-5">
        <div set:html={plot.outerHTML}></div>
      </figure>
    </main>
  </div>
</Layout>
