---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import populationMain from "../assets/populationMain.json";

const listePeriode = [...new Set(populationMain.map((entry) => entry["Période"]))].sort(
  (a, b) => b - a
);
const listeSexe = [...new Set(populationMain.map((entry) => entry["Sexe"]))].sort();
const listeAge = [...new Set(populationMain.map((entry) => entry["Âge"]))].sort((a, b) =>
  a.localeCompare(b, "fr")
);
---

<Layout>
  <div class="min-h-screen bg-slate-50 text-slate-800">
    <main class="mx-auto max-w-6xl px-5 py-8">
      <Header />

      <header class="mb-10 border-b border-slate-300 pb-7">
        <h1 class="text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
          Population des départements
        </h1>
        <p class="mt-3 text-base text-slate-600">
          Carte générée côté client à partir des données GeoJSON et du fichier de population.
        </p>
      </header>

      <section class="mb-6 border border-slate-200 bg-white p-5">
        <h2 class="mb-4 text-lg font-semibold text-slate-950">Paramètres de la carte</h2>
        <div class="flex flex-wrap gap-5">
          <div>
            <label for="periode" class="mb-2 block text-sm font-medium text-slate-700">
              Période
            </label>
            <select id="periode" aria-label="Sélectionner une période" class="rounded-md border border-slate-300 bg-white px-3 py-2">
              {
                listePeriode.map((periode) => (
                  <option value={periode} selected={periode === 2021}>
                    {periode}
                  </option>
                ))
              }
            </select>
          </div>

          <div>
            <label for="sexe" class="mb-2 block text-sm font-medium text-slate-700">
              Sexe
            </label>
            <select id="sexe" aria-label="Sélectionner un sexe" class="rounded-md border border-slate-300 bg-white px-3 py-2">
              {
                listeSexe.map((sexe) => (
                  <option value={sexe} selected={sexe === "Total"}>
                    {sexe}
                  </option>
                ))
              }
            </select>
          </div>

          <div>
            <label for="age" class="mb-2 block text-sm font-medium text-slate-700">
              Âge
            </label>
            <select id="age" aria-label="Sélectionner un âge" class="rounded-md border border-slate-300 bg-white px-3 py-2">
              {
                listeAge.map((age) => (
                  <option value={age} selected={age === "Total"}>
                    {age.trim()}
                  </option>
                ))
              }
            </select>
          </div>
        </div>
      </section>

      <figure class="overflow-x-auto border border-slate-200 bg-white p-3 sm:p-5">
        <div
          id="population-map"
          role="img"
          aria-label="Carte de la population des départements français"
        >
          <p class="p-5 text-slate-600">Chargement de la carte…</p>
        </div>
        <figcaption class="mt-3 text-sm text-slate-600">
          Figure 1. Carte de la population départementale générée côté client.
        </figcaption>
      </figure>
    </main>
  </div>
</Layout>

<script>
  import * as Plot from "@observablehq/plot";
  import populationMain from "../assets/populationMain.json";
  import departements from "../assets/departements.geojson.json";

  const elmYear = document.getElementById("periode") as HTMLSelectElement;
  const elmSex = document.getElementById("sexe") as HTMLSelectElement;
  const elmAge = document.getElementById("age") as HTMLSelectElement;
  const mapContainer = document.querySelector("#population-map") as HTMLDivElement;

  function renderMap() {
    const selectedPeriod = Number(elmYear.value);
    const selectedSex = elmSex.value;
    const selectedAge = elmAge.value;

    const populationByDepartment = new Map(
      populationMain
        .filter(
          (entry) =>
            entry["Période"] === selectedPeriod &&
            entry["Sexe"] === selectedSex &&
            entry["Âge"] === selectedAge
        )
        .map((entry) => [entry["Géographie"], entry.Valeur])
    );

    const features = departements.features.map((feature) => ({
      ...feature,
      properties: {
        ...feature.properties,
        population: populationByDepartment.get(feature.properties.nom) ?? null,
      },
    }));

    const plot = Plot.plot({
      width: 960,
      height: 680,
      title: `Population des départements français en ${selectedPeriod}`,
      subtitle: `Population selon le sexe « ${selectedSex} » et l'âge « ${selectedAge.trim()} ».`,
      caption: "Figure 1. Population départementale selon les données du recensement.",
      ariaLabel: `Carte choroplèthe de la population des départements français en ${selectedPeriod}.`,
      projection: {
        type: "mercator",
        domain: { type: "FeatureCollection", features },
      },
      color: {
        scheme: "YlGnBu",
        label: "Population",
        legend: true,
        unknown: "#e5e7eb",
      },
      marks: [
        Plot.geo(features, {
          fill: "population",
          stroke: "white",
          strokeWidth: 0.5,
          tip: true,
        }),
      ],
    });

    mapContainer.replaceChildren(plot);
  }

  [elmYear, elmSex, elmAge].forEach((select) => {
    select.addEventListener("change", renderMap);
  });
  renderMap();
</script>
