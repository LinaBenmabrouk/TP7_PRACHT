---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import cars from "../../../assets/cars.json";

const years = [...new Set(cars.map((car) => car.year))].sort((a, b) => a - b);
---

<Layout>
  <div class="min-h-screen bg-slate-50 text-slate-800">
    <main class="mx-auto max-w-6xl px-5 py-8">
      <Header />

      <header class="mb-10 border-b border-slate-300 pb-7">
        <h1 class="text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
          Voitures par année
        </h1>
        <p class="mt-3 text-base text-slate-600">
          Choisissez une année pour consulter le graphique correspondant.
        </p>
      </header>

      <ul class="grid gap-3 sm:grid-cols-3 lg:grid-cols-5">
        {
          years.map((year) => (
            <li>
              <a
                href={`/cars/year/${year}/`}
                class="block border border-slate-200 bg-white px-4 py-3 font-medium text-slate-700 shadow-sm transition hover:border-slate-400 hover:bg-slate-100"
              >
                Année : {year}
              </a>
            </li>
          ))
        }
      </ul>
    </main>
  </div>
</Layout>