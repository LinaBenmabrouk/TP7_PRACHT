---
import Layout from "../../../layouts/Layout.astro";
import Header from "../../../components/Header.astro";
import PlotFigure from "../../../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import cars from "../../../assets/cars.json";

export const prerender = false;

const { year } = Astro.params;
const filteredCars = cars.filter((car) => car.year.toString() === year);

const plotOptions = {
  grid: true,
  marks: [
    Plot.dot(filteredCars, {
      x: "weight (lb)",
      y: "power (hp)",
      fill: "steelblue",
      r: 4,
      fillOpacity: 0.7,
    }),
  ],
  x: {
    label: "Poids (lb)",
  },
  y: {
    label: "Puissance (hp)",
  },
  title: `Relation puissance / poids - voitures ${year}`,
};
---

<Layout>
  <div class="min-h-screen bg-slate-50 text-slate-800">
    <main class="mx-auto max-w-6xl px-5 py-8">
      <Header />

      <header class="mb-10 border-b border-slate-300 pb-7">
        <h1 class="text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
          Voitures de l'année {year}
        </h1>
        <p class="mt-3 text-base text-slate-600">
          {filteredCars.length} voiture(s) trouvée(s) pour cette année.
        </p>
      </header>

      {
        filteredCars.length > 0 ? (
          <section class="border border-slate-200 bg-white p-5">
            <PlotFigure options={plotOptions} />
          </section>
        ) : (
          <p class="border border-amber-200 bg-amber-50 p-5 text-amber-800">
            Aucune voiture trouvée pour l'année {year}.
          </p>
        )
      }
    </main>
  </div>
</Layout>