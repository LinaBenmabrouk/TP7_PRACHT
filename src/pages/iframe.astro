---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---


<Layout>
 <div class="min-h-screen bg-slate-50 text-slate-800">
   <main class="mx-auto max-w-6xl px-5 py-8">
     <Header />


     <header class="mb-8 border-b border-slate-300 pb-7">
       <h1 class="text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
         Visualisation dans un iframe
       </h1>
       <p class="mt-3 text-base text-slate-600">
         Le choix d'une espèce modifie la source de l'iframe avec JavaScript.
       </p>
     </header>


     <label for="iframe-species" class="mb-2 block text-sm font-medium text-slate-700">
       Choisir une espèce
     </label>
     <select
       id="iframe-species"
       class="mb-6 cursor-pointer rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm outline-none transition hover:border-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
     >
       <option value="Adelie">Adelie</option>
       <option value="Gentoo">Gentoo</option>
       <option value="Chinstrap">Chinstrap</option>
     </select>


     <iframe
       id="species-frame"
       src="/species/Adelie/"
       title="Visualisation de l'espèce sélectionnée"
       class="h-[720px] w-full border border-slate-300 bg-white"
     ></iframe>
   </main>
 </div>


 <script>
   const iframeSpeciesSelect = document.querySelector("#iframe-species") as HTMLSelectElement | null;
   const speciesFrame = document.querySelector("#species-frame") as HTMLIFrameElement | null;


   iframeSpeciesSelect?.addEventListener("change", (event) => {
     const select = event.currentTarget as HTMLSelectElement;


     if (speciesFrame && select.value) {
       speciesFrame.src = `/species/${select.value}/`;
     }
   });
 </script>
</Layout>