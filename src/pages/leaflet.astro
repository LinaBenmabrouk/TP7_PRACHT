---
import "leaflet/dist/leaflet.css";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
---

<Layout>
  <div class="min-h-screen bg-slate-50 text-slate-800">
    <main class="mx-auto max-w-6xl px-5 py-8">
      <Header />

      <header class="mb-10 border-b border-slate-300 pb-7">
        <h1 class="text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
          Établissements en France
        </h1>
        <p class="mt-3 text-base text-slate-600">
          Carte interactive des établissements. Sélectionnez un marqueur pour afficher son nom.
        </p>
      </header>

      <figure class="border border-slate-200 bg-white p-3 sm:p-5">
        <div
          id="map"
          class="h-[600px] w-full"
          role="img"
          aria-label="Carte interactive des établissements en France"
        >
        </div>
        <figcaption class="mt-3 text-sm text-slate-600">
          Figure 1. Localisation des établissements représentés sur une carte Leaflet.
          Fond cartographique © OpenStreetMap contributors.
        </figcaption>
      </figure>
    </main>
  </div>
</Layout>

<style>
  :global(.leaflet-marker-shadow) {
    display: none;
  }
</style>

<script>
  import * as L from "leaflet";
  import listeEtablissements from "../assets/listeEtablissements.json";
  import markerIcon from "leaflet/dist/images/marker-icon.png";
  import markerIcon2x from "leaflet/dist/images/marker-icon-2x.png";
  import markerShadow from "leaflet/dist/images/marker-shadow.png";

  // En production, Leaflet ne retrouve pas ses images par défaut : on les fournit explicitement
  L.Marker.prototype.options.icon = L.icon({
    iconUrl: markerIcon.src,
    iconRetinaUrl: markerIcon2x.src,
    shadowUrl: markerShadow.src,
    iconSize: [25, 41],
    iconAnchor: [12, 41],
    popupAnchor: [1, -34],
    shadowSize: [41, 41],
  });

  type Etablissement = {
    name: string;
    lat: number;
    lon: number;
  };

  const map = L.map("map").setView([46.6033, 1.883], 6);

  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    attribution: "&copy; OpenStreetMap contributors",
    maxZoom: 19,
  }).addTo(map);

  listeEtablissements.forEach((etablissement: Etablissement) => {
    const marker = L.marker([
      etablissement.lat,
      etablissement.lon,
    ]).addTo(map);

    const popupContent = document.createElement("strong");
    popupContent.textContent = etablissement.name;
    marker.bindPopup(popupContent);
  });
</script>
