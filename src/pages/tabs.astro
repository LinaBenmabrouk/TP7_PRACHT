---
import { Tabs, TabsList, TabsPanel, TabsTab } from "accessible-astro-components";
import Layout from "../layouts/Layout.astro";
import GraphicSpecies from "../components/GraphicSpecies.astro";
import Header from "../components/Header.astro";
---


<Layout>
 <div class="min-h-screen bg-slate-50 text-slate-800">
   <main class="mx-auto max-w-6xl px-5 py-8">
     <Header />


     <header class="mb-10 border-b border-slate-300 pb-7">
       <h1 class="text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
         Les espèces de Penguins
       </h1>


       <p class="mt-3 text-base text-slate-600">
         Visualisation des différentes espèces de manchots avec des onglets accessibles.
       </p>
     </header>

      <Tabs>
        <TabsList aria-label="Espèces de manchots">
          <TabsTab
            id="tab-adelie"
            controls="panel-adelie"
            selected
            class="rounded-t-md border-b-2 border-transparent px-4 py-3 text-sm font-semibold text-slate-600 aria-selected:border-slate-900! aria-selected:bg-slate-900! aria-selected:text-white!"
          >
            Adelie
          </TabsTab>
          <TabsTab
            id="tab-gentoo"
            controls="panel-gentoo"
            class="rounded-t-md border-b-2 border-transparent px-4 py-3 text-sm font-semibold text-slate-600 hover:bg-slate-200 aria-selected:border-slate-900! aria-selected:bg-slate-900! aria-selected:text-white!"
          >
            Gentoo
          </TabsTab>
          <TabsTab
            id="tab-chinstrap"
            controls="panel-chinstrap"
            class="rounded-t-md border-b-2 border-transparent px-4 py-3 text-sm font-semibold text-slate-600 hover:bg-slate-200 aria-selected:border-slate-900! aria-selected:bg-slate-900! aria-selected:text-white!"
          >
            Chinstrap
          </TabsTab>
        </TabsList>

        <TabsPanel
          id="panel-adelie"
          labelledby="tab-adelie"
          selected
          class="border border-slate-200 bg-white"
        >
          <div class="border-b border-slate-200 px-5 py-4">
            <h2 class="text-xl font-semibold">Penguins Adelie</h2>
          </div>
          <div class="overflow-x-auto px-3 py-5">
            <GraphicSpecies species="Adelie" />
          </div>
        </TabsPanel>

        <TabsPanel
          id="panel-gentoo"
          labelledby="tab-gentoo"
          class="border border-slate-200 bg-white"
        >
          <div class="border-b border-slate-200 px-5 py-4">
            <h2 class="text-xl font-semibold">Penguins Gentoo</h2>
          </div>
          <div class="overflow-x-auto px-3 py-5">
            <GraphicSpecies species="Gentoo" />
          </div>
        </TabsPanel>

        <TabsPanel
          id="panel-chinstrap"
          labelledby="tab-chinstrap"
          class="border border-slate-200 bg-white"
        >
          <div class="border-b border-slate-200 px-5 py-4">
            <h2 class="text-xl font-semibold">Penguins Chinstrap</h2>
          </div>
          <div class="overflow-x-auto px-3 py-5">
            <GraphicSpecies species="Chinstrap" />
          </div>
        </TabsPanel>
      </Tabs>
   </main>
 </div>

 <script>
   const tabs = Array.from(document.querySelectorAll<HTMLElement>('[role="tab"]'));
   const selectTab = (selectedTab: HTMLElement) => {
     tabs.forEach((tab) => {
       const isSelected = tab === selectedTab;
       const panel = document.getElementById(tab.getAttribute("aria-controls") ?? "");


       tab.setAttribute("aria-selected", String(isSelected));
       tab.tabIndex = isSelected ? 0 : -1;
       panel?.toggleAttribute("hidden", !isSelected);
     });
   };

   tabs.forEach((tab, index) => {
     tab.addEventListener("click", () => selectTab(tab));

     tab.addEventListener("keydown", (event) => {
       let nextIndex: number | undefined;

       if (event.key === "ArrowRight") nextIndex = (index + 1) % tabs.length;
       if (event.key === "ArrowLeft") nextIndex = (index - 1 + tabs.length) % tabs.length;
       if (event.key === "Home") nextIndex = 0;
       if (event.key === "End") nextIndex = tabs.length - 1;

       if (nextIndex !== undefined) {
         event.preventDefault();
         tabs[nextIndex].focus();
         selectTab(tabs[nextIndex]);
       }
     });
   });
   selectTab(tabs[0]);
 </script>
</Layout>