---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
---

<Layout>
  <div class="min-h-screen bg-slate-50 text-slate-800">
    <main class="mx-auto max-w-6xl px-5 py-8">
      <Header />

      <header class="mb-10 border-b border-slate-300 pb-7">
        <h1 class="text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
          Météo avec plusieurs filtres
        </h1>
        <p class="mt-3 text-base text-slate-600">
          Filtrer les relevés météo par ville et par type de météo.
        </p>
      </header>

      <section class="border border-slate-200 bg-white p-5">
        <div class="flex flex-wrap gap-5">
          <div>
            <label for="location-filter" class="mb-2 block text-sm font-medium text-slate-700">
              Ville
            </label>
            <select id="location-filter" class="cursor-pointer rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm outline-none transition hover:border-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200">
              <option value="">Toutes les villes</option>
              <option value="Seattle">Seattle</option>
              <option value="New York">New York</option>
            </select>
          </div>

          <div>
            <label for="weather-filter" class="mb-2 block text-sm font-medium text-slate-700">
              Météo
            </label>
            <select id="weather-filter" class="cursor-pointer rounded-md border border-slate-300 bg-white px-3 py-2 text-sm font-medium text-slate-700 shadow-sm outline-none transition hover:border-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200">
              <option value="">Toutes les météos</option>
              <option value="drizzle">Drizzle</option>
              <option value="rain">Rain</option>
              <option value="sun">Sun</option>
              <option value="snow">Snow</option>
              <option value="fog">Fog</option>
            </select>
          </div>
        </div>

        <div id="myplot" class="mt-6"></div>
      </section>
    </main>
  </div>

  <script>
    import * as Plot from "@observablehq/plot";
    import weather from "../../assets/weather.json";

    const locationFilter = document.querySelector("#location-filter") as HTMLSelectElement;
    const weatherFilter = document.querySelector("#weather-filter") as HTMLSelectElement;
    const plotContainer = document.querySelector("#myplot") as HTMLDivElement;

    function renderPlot() {
      const location = locationFilter.value;
      const weatherType = weatherFilter.value;
      const filteredWeather = weather.filter((entry) => {
        const matchesLocation = !location || entry.location === location;
        const matchesWeather = !weatherType || entry.weather === weatherType;

        return matchesLocation && matchesWeather;
      });

      plotContainer.replaceChildren();

      const plot = Plot.plot({
        grid: true,
        color: { legend: true },
        x: { label: "Vent" },
        y: { label: "Température maximale (°C)" },
        marks: [
          Plot.dot(filteredWeather, {
            x: "wind",
            y: "temp_max",
            fill: "weather",
            tip: true,
          }),
        ],
      });

      plotContainer.append(plot);
    }

    [locationFilter, weatherFilter].forEach((select) => {
      select.addEventListener("change", renderPlot);
    });
    renderPlot();
  </script>
</Layout>
