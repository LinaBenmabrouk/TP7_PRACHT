---
import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";
---

<Layout>
  <div class="min-h-screen bg-slate-50 text-slate-800">
    <main class="mx-auto max-w-6xl px-5 py-8">
      <Header />

      <header class="mb-10 border-b border-slate-300 pb-7">
        <h1 class="text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
          Météo simple
        </h1>
        <p class="mt-3 text-base text-slate-600">
          Visualisation du dataset météo, affichée côté client.
        </p>
      </header>

      <section class="border border-slate-200 bg-white p-5">
        <div id="myplot"></div>
      </section>
    </main>
  </div>

  <script>
    import * as Plot from "@observablehq/plot";
    import weather from "../../assets/weather.json";

    const plot = Plot.plot({
      grid: true,
      color: { legend: true },
      x: { label: "Vent" },
      y: { label: "Température maximale (°C)" },
      marks: [
        Plot.dot(weather, {
          x: "wind",
          y: "temp_max",
          fill: "weather",
          tip: true,
        }),
      ],
    });

    document.querySelector("#myplot")?.append(plot);
  </script>
</Layout>
