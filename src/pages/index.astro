---
import PlotFigure from "../components/PlotFigure.astro";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import * as Plot from "@observablehq/plot";
import penguins from "../assets/penguins.json";

const scatterOptions = {
  title: "Manchots : Longueur vs Profondeur du bec",
  ariaLabel: "Nuage de points comparant la longueur et la profondeur du bec par espèce",
  marginBottom: 40,
  grid: true,
  color: {
    legend: true,
    type: "categorical",
    domain: ["Adelie", "Chinstrap", "Gentoo"],
    range: ["#377eb8", "#ffd92f", "#e41a1c"],
  },
  marks: [
    Plot.dot(penguins, {
      x: "culmen_length_mm",
      y: "culmen_depth_mm",
      stroke: "species",
    }),
  ],
};
---

<Layout>
  <div class="min-h-screen bg-slate-50 text-slate-800">
    <div class="mx-auto max-w-6xl px-5 py-8">
      <Header />

      <header class="mb-10 border-b border-slate-300 pb-7">
        <h1 class="text-3xl font-semibold tracking-tight text-slate-950 sm:text-4xl">
          Visualisations du dataset Penguins
        </h1>

        <p class="mt-3 text-base text-slate-600">
          Étude de la longueur et de la profondeur du bec selon l'espèce.
        </p>
      </header>

      <section class="border border-slate-200 bg-white">
        <div class="border-b border-slate-200 px-5 py-4 sm:px-7">
          <h2 class="text-xl font-semibold text-slate-950">
            Nuage de points
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Longueur et profondeur du bec par espèce.
          </p>
        </div>

        <div class="overflow-x-auto px-3 py-5 sm:px-7">
          <PlotFigure options={scatterOptions} />
        </div>
      </section>
    </div>
  </div>
</Layout>